# Copy to .env and fill in your Plaid credentials.
# Get sandbox keys free at https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# One of: sandbox | production   (start with sandbox)
PLAID_ENV=sandbox

# Comma-separated Plaid products to request in Link.
PLAID_PRODUCTS=transactions

# Comma-separated country codes.
PLAID_COUNTRY_CODES=US

# Allowed frontend origin for CORS (the dashboard Vite dev server).
CORS_ORIGINS=http://localhost:5174
