# Copy to .env. Never put real secrets in this file — it is committed.
# Leave these blank and the app auto-generates random ones on first run, saved to
# backend/instance/secret_key.key and jwt_secret_key.key (gitignored) and reused
# every run after. Set them explicitly in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# SQLite by default. Swap for postgres:// etc. later without touching code.
DATABASE_URL=sqlite:///savesmart.db

# Access token lifetime in minutes.
JWT_ACCESS_MINUTES=60

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Set to 1 to enable GET /api/admin/state — an UNAUTHENTICATED dump of every
# user's finances. Dev debugging only; leave unset otherwise.
SAVESMART_ADMIN=

# --- Plaid (bank linking). Get free sandbox keys at ---
# https://dashboard.plaid.com/developers/keys  (leave blank to disable linking)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# --- Assistant (Claude Haiku). Leave blank to disable the chat assistant. ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Encryption key for secrets at rest (Plaid access tokens). ---
# Leave blank and the app auto-generates one on first run, saved to
# backend/instance/token.key (gitignored) and reused every run after.
# Set this explicitly in production (e.g. from a secrets manager). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

