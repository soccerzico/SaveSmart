# Copy to .env and change the secrets before running anything real.
# Use a long random string in production, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=dev-only-change-me-jwt-0123456789abcdef0123456789abcdef

# SQLite by default. Swap for postgres:// etc. later without touching code.
DATABASE_URL=sqlite:///savesmart.db

# Access token lifetime in minutes.
JWT_ACCESS_MINUTES=60

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
